{
    "layer": "top", // Waybar at top layer
    "position": "top", // Waybar position (top|bottom|left|right)
    "spacing": 4, // Gaps between modules (4px)
    "modules-left": [
      "hyprland/workspaces",
      "hyprland/window"
    ],
    "modules-center": [
      "systemd-failed-units",
      "custom/docker"
      // "custom/ssh",
    ],
    "modules-right": [
      // "temperature",
      "cpu",
      "memory",
      "disk#root",
      "pulseaudio#output",
      "pulseaudio#source",
      "backlight",
      // "custom/tailscale",
      "network",
      "battery",
      "clock#date",
      "clock#time",
      "custom/beattime",
      // "clock#UTC",
      "tray"
    ],

    // Modules configuration
    "hyprland/workspaces": {
        "disable-scroll": true,
        "active-only": false,
        "all-outputs": false,
        "warp-on-scroll": false,
        "format": " {icon} <small>{windows}</small> ",
        "format-window-separator": "  ",
        "format-icons": {
            "1": "➊",
            "2": "➋",
            "3": "➌",
            "4": "➍",
            "5": "➎",
            "6": "➏",
            "7": "➐",
            "8": "➑",
            "9": "➒",
            "10": "➓",
            // "urgent": "",
            // "focused": "",
            // "empty": "",
            // "default": "",
            // "active": ""
        },
        "window-rewrite-default": "",
        "window-rewrite": {
            "class<firefox>": "",
            "class<firefox> title<.*Discord.*>": "󰙯",
            "class<firefox> title<.*Telegram.*>": "",
            "class<firefox> title<.*youtube.*>": "",
            "class<firefox> title<.*github.*>": "",
            "class<firefox> title<.*gitlab.*>": "",
            "class<kitty>": "",
            "class<kitty> title<nvim.*>": "",
            "class<org.telegram.desktop>": "",
            "class<Discord>": "󰙯",
          },
    },
    "hyprland/window": {
      "max-length": 120,
      "separate-outputs": true,
      // "expand": true,
    },
    "wlr/taskbar": {
        "format": " {icon} ",
        "tooltip-format": "{name}: {title}",
        "on-click": "activate",
    },
    "tray": {
        // "icon-size": 21,
        "show-passive-items": true,
        "spacing": 10,
    },
    "custom/weather": {
      "format": "{}", // TODO: cut to only first character, which should be an icon
      "format-alt": "{}",
      "exec": "curl -s 'wttr.in/?format=%c+%l:+%C+%t+%w+%h' | sed 's/,.*:/:/g' | sed 's/  / /g'",
      "interval": 1800,

    },
    "clock#date": {
        "interval": 600,
        // "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "tooltip": false,
        "format": "{:%a %F}",
    },
    "clock#time": {
        "interval": 10,
        "format": "{:%I:%M %p}",
        "tooltip": false,
    },
    "clock#UTC": {
        "interval": 10,
        "format": "{:%H:%M} UTC",
        "tooltip": false,
        "timezone": "UTC",
      },
    "custom/beattime": {
        "interval": 10,
        "exec": "printf \"%03d\n\" \"$((((($(date +%s)+3600)%86400)*10)/864))\"",
        "format": "@{}",
      },
    "custom/docker": {
      "interval": 10,
      "format": "{}",
      "exec": "count=$(docker ps -q 2>/dev/null | wc -l); [ \"$count\" -gt 0 ] && echo \"  $count\"",
      "return-type": "plain",
      "tooltip": false
    },
    "custom/tailscale": {
      "interval": 3600,
      "format": "󰖂 ",
      "format-alt": "󰖂  {}",
      "exec": "echo $(tailscale switch --list | awk '{ print $3 }' | sed -nr 's/\\*//p')  $(tailscale status --json | jq -r '.MagicDNSSuffix')",
      "return-type": "plain",
      "tooltip": false
    },
    "custom/ssh": {
      "interval": 10,
      "format": "{}",
      "exec": "count=$(ss -tnp 2>/dev/null | grep -c ssh); [ \"$count\" -gt 0 ] && echo \"󱠾 $count\"",
      "tooltip": false
    },
    "cpu": {
        "interval": 10,
        "format": " ",
        "format-alt": "  {usage}% ({load})",
        "states": {
            "warning": 70,
            "critical": 85,
        },
        "tooltip": false,
    },
    "temperature": {
        "interval": 10,
        "critical-threshold": 75,
        "format": "{icon}",
        "format-alt": "{icon} {temperatureC}°C",
        "format-icons": ["", "", "", "", ""],
        "tooltip": false,
    },
    "memory":{
        "interval": 10,
        "format": " ",
        "format-alt": "  {used:0.1f}G/{total:0.1f}G",
        "states": {
            "warning": 60,
            "critical": 80,
        },
        "tooltip": false
    },
    "disk#root": {
      "interval": 300,
      "path": "/",
      "format": "󰋊",
      "format-alt": "󰋊 {percentage_used}%: {used} / {total}",
      "states": {
          "warning": 25,
          "critical": 10
      },
      "tooltip": false,
    },
    "disk#home": {
      "interval": 300,
      "path": "/home",
      "format": "󰋞",
      "format-alt": "󰋞 {percentage_used}%: {used} / {total}",
      "states": {
          // "good": 95,
          "warning": 25,
          "critical": 10
      },
      "tooltip": false,
    },
    "backlight": {
        "format": "{icon}",
        "format-alt": "{icon} {percent}%",
        "format-icons": ["", "", "", "", "", "", "", "", ""],
        "tooltip": false,
    },
    "hyprland/language": {
        "format": "{}",
        "format-en": "EN",
        "format-jp": "JP",
        "format-fr": "FR",
        "format-es": "ES",
        "format-tok": "TP",
        "keyboard-name": "at-translated-set-2-keyboard",
    },
    "battery": {
        "interval": 30,
        "states": {
            "good": 95,
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-full": "{icon}",
        "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "tooltip": false,
    },
    "network": {
        "interval": 10,
        "format": "{icon} ",
        "format-wifi": "{icon} ",
        "format-ethernet": "󰈀  {ipaddr}",
        "format-linked": "󰈀  {ifname} (No IP)",
        "format-disconnected": "󰖪",
        "format-alt": "{icon}  {ipaddr} via {essid}",
        "format-alt-wifi": "{icon}  {ipaddr} via {essid}",
        "format-alt-ethernet": "{icon} {ipaddr}",
        "format-icons": ["󰤟", "󰤢", "󰤥", "󰤨"],
        "tooltip": false,
    },
    "pulseaudio#output": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟",
        "format-bluetooth": "{icon}  {volume}%",
        "format-bluetooth-muted": "󰝟 ",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        // "on-click": "pavucontrol",
        "scroll-step": 1.0,
        "tooltip": false
    },
    "pulseaudio#source": {
        "format": "{format_source}",
        "format-source": "󰍬 {volume}%",
        "format-source-muted": "󰍭",
        // "on-scroll-up": "pactl set-source-volume 0 +1%",
        // "on-scroll-down": "pactl set-source-volume 0 -1%",
        // "on-click": "pavucontrol",
        // "scroll-step": 0.5,
        "tooltip": false,
    },
  "systemd-failed-units": {
    "format": " {nr_failed} failing unit",
    // "format-ok": "",
  }
}
